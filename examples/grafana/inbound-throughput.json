      "description": "Selected download and upload measurements currently in failure, error, or stale state. Initial jittered measurements remain unknown and are not counted.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
