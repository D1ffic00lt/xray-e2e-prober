          "editorMode": "code",
          "expr": "sum((synthetic_check_upload_state{instance_id=~\"$instance_id\",target_id=~\"$upload_target_id\",state=~\"failure|error|stale\"} == 1) and on(check_id,instance_id) synthetic_check_info{entry_name=~\"$entry_name\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Upload",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Problems",
      "type": "stat"
