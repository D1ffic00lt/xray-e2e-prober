      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$server"
          },
          "editorMode": "code",
          "expr": "sum((synthetic_check_download_state{instance_id=~\"$instance_id\",target_id=~\"$download_target_id\",state=~\"failure|error|stale\"} == 1) and on(check_id,instance_id) synthetic_check_info{entry_name=~\"$entry_name\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Download",
          "range": false,
          "refId": "A"
